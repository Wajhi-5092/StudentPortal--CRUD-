@{
}
@model List<StudentPortal.web.Models.Entities.Student>
<h1>Student</h1>

<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Is Active</th>
        </tr>
    </thead>
    <tbody>

        @foreach (var student in Model)
        {
            <tr>
                <td>@student.Name</td>
                <td>@student.Email</td>
                <td>@student.PhoneNumber</td>
                <td>@(student.IsActive ? "Yes" : "No")</td>
                <td>    
                    <a class="btn btn-primary"
                       asp-controller="Student"
                       asp-action="Edit"
                       asp-route-id="@student.Id">
                        Edit
                    </a>
                    </td>
            </tr>
        }

      </tbody>
</table>